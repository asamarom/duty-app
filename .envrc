# direnv configuration for Duty Tactical Management System
# Automatically loads the Nix flake development environment

# Use the Nix flake
use flake

# Load .env file if it exists (for local overrides)
dotenv_if_exists .env.local

# Set up Firebase emulator environment variables
export VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
export VITE_FIRESTORE_EMULATOR_HOST=localhost:8085
export VITE_TEST_MODE=true

# Inform the user
echo "✅ direnv: Duty Tactical Management System environment loaded"
